# --- Server (loaded by server/config.js via dotenv) ---
PORT=4000
MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# Comma-separated browser origins allowed by CORS. "*" allows any origin (dev only).
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Vite frontend (only VITE_* variables are exposed to the browser) ---
# Leave VITE_API_URL empty to use the localStorage-backed DEMO data layer.
# Set it to the server base URL (no trailing slash) to use the live Express API.
VITE_API_URL=

# Optional. If set, generatePlan() POSTs to this endpoint and falls back to the
# local deterministic demo generator on any error. Never put API keys here.
VITE_AI_ENDPOINT=
